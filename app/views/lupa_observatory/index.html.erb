<% content_for :title, "LUPA Observatory" %>
<% content_for :section, "LUPA / Observatório" %>
<div class="page-heading">
  <div><div class="eyebrow">EPA · LUPA OBSERVATORY</div>
    <h1>Explicabilidade dos modelos</h1>
    <p>Investigue a sensibilidade do Random Forest por variável e compare os protocolos N1, N2 e N3 em experimentos sintéticos.</p>
  </div><span class="tag">INTERPRETAÇÃO NÃO CAUSAL</span>
</div>
<section class="panel">
  <div class="panel-heading"><div><div class="eyebrow">SELEÇÃO DO EXPERIMENTO</div><h3>Protocolo e execução</h3></div></div>
  <%= form_with url: lupa_observatory_path, method: :get, class: "experiment-form" do |f| %>
    <label for="protocol">Momento da previsão</label>
    <%= select_tag :protocol, options_for_select([["Early · N1", "early"], ["Trajectory · N2", "trajectory"], ["Consolidated · N3", "consolidated"]], @protocol), class: "input" %>
    <label for="run_id">Execução MAPA</label>
    <%= select_tag :run_id, options_for_select(@observatory[:rows].map { |r| ["##{r[:run_id]} · seed #{r[:seed]}", r[:run_id]] }, @row&.dig(:run_id)), class: "input" %>
    <%= f.submit "Analisar variáveis", class: "button button-primary" %>
  <% end %>
</section>
<% if @row %>
  <% if @scene %>
    <section class="panel">
      <div class="panel-heading"><div><div class="eyebrow">LUPA · ESPAÇO DE SENSIBILIDADE</div><h3>Observatório 3D · N1 / N2 / N3</h3></div><span class="subtle-pill">33 MEDIÇÕES</span></div>
      <p class="muted">X = variável, Y = queda assinada de F1 macro por permutação, Z = protocolo. A perspectiva é geométrica; não significa relação causal ou distância estatística entre protocolos.</p>
      <div class="lupa-scene" data-lupa-scene>
        <script type="application/json" data-scene-json><%= raw json_escape(@scene.to_json) %></script>
        <div class="lupa-scene-filters">
          <label for="lupa-feature-select">Variável</label>
          <select id="lupa-feature-select" data-feature-filter class="input">
            <option value="all">Todas as variáveis</option>
            <% @scene[:protocols].first[:features].each do |feature| %>
              <option value="<%= feature[:name] %>"><%= feature[:name] %></option>
            <% end %>
          </select>
          <label for="lupa-protocol-select">Protocolo</label>
          <select id="lupa-protocol-select" data-protocol-filter class="input">
            <option value="all">N1 + N2 + N3</option>
            <option value="early">N1</option>
            <option value="trajectory">N2</option>
            <option value="consolidated">N3</option>
          </select>
          <label><input type="checkbox" data-show-dispersion> ±1 desvio de permutação</label>
        </div>
        <canvas width="1050" height="530" tabindex="0" role="img" aria-label="Visualização 3D de onze variáveis em três protocolos, com importância positiva ou negativa. Use setas para girar, mais e menos para ampliar. Os dados também aparecem na tabela acessível abaixo."></canvas>
        <div class="lupa-scene-controls">
          <button type="button" data-rotate="-1" class="button button-outline">Girar esquerda</button>
          <button type="button" data-rotate="1" class="button button-outline">Girar direita</button>
          <button type="button" data-zoom="1" class="button button-outline">Ampliar</button>
          <button type="button" data-zoom="-1" class="button button-outline">Reduzir</button>
          <button type="button" data-reset class="button button-outline">Restaurar</button>
        </div>
        <p class="muted" aria-live="polite" data-scene-detail>Selecione um ponto no gráfico para visualizar o valor medido.</p>
      </div>
      <details><summary>Tabela acessível das 33 medições</summary>
        <div class="table-wrap"><table class="runs-table"><thead><tr><th>Protocolo</th><th>Variável</th><th>Queda F1</th><th>Desvio</th></tr></thead><tbody>
          <% @scene[:protocols].each do |protocol| %>
            <% protocol[:features].each do |feature| %>
              <tr><td><%= protocol[:protocol] %></td><td><%= feature[:name] %></td>
                <td><%= number_with_precision(feature[:importance], precision: 4) %></td>
                <td><%= number_with_precision(feature[:dispersion], precision: 4) %></td></tr>
            <% end %>
          <% end %>
        </tbody></table></div>
      </details>
    </section>
  <% end %>
  <section class="panel">
    <div class="panel-heading"><div><div class="eyebrow">PERMUTATION IMPORTANCE · HOLDOUT POR ALUNO</div><h3>Queda do F1 macro por variável</h3></div><span class="subtle-pill">RANDOM FOREST</span></div>
    <div class="stats-grid">
      <div class="stat-card"><div class="stat-label">F1 macro referência</div><div class="stat-value"><%= number_with_precision(@row[:score], precision: 3) %></div></div>
      <div class="stat-card"><div class="stat-label">Observações no teste</div><div class="stat-value"><%= @row[:test_observations] %></div></div>
      <div class="stat-card"><div class="stat-label">Experimento</div><div class="stat-value">#<%= @row[:run_id] %></div></div>
    </div>
    <% scale = [@row[:features].map { |f| f["mean_f1_drop"].abs }.max || 0.0, 0.000001].max %>
    <div class="lupa-bars" role="img" aria-label="Gráfico de importância das variáveis do modelo">
    <% @row[:features].each do |feature| %>
      <div class="lupa-bar-row">
        <span class="lupa-feature"><%= feature["name"] %></span>
        <div class="lupa-track"><div class="lupa-fill <%= feature["mean_f1_drop"] < 0 ? "lupa-negative" : "" %>" style="width:<%= number_with_precision(feature["mean_f1_drop"].abs / scale * 100, precision: 1) %>%"></div></div>
        <strong class="lupa-value"><%= number_with_precision(feature["mean_f1_drop"], precision: 4) %></strong>
      </div>
    <% end %>
    </div>
    <p class="muted">Magnitude absoluta da variação apresentada nas barras; o valor numérico preserva o sinal. Importâncias negativas não são convertidas em zero.</p>
    <p><%= link_to "Abrir relatório científico da execução →", mapa_run_path(@row[:run_id]), class: "text-link" %></p>
  </section>
  <section class="panel">
    <div class="panel-heading"><div><h3>Outras execuções no mesmo protocolo</h3></div><span class="subtle-pill"><%= @observatory[:total] %> DISPONÍVEIS</span></div>
    <div class="table-wrap"><table class="runs-table"><thead><tr><th>Execução</th><th>Seed</th><th>F1 referência</th><th>Variável mais sensível</th></tr></thead><tbody>
    <% @observatory[:rows].each do |entry| %>
      <tr class="<%= entry[:run_id] == @row[:run_id] ? "highlight-row" : "" %>"><td><%= link_to "##{entry[:run_id]}", lupa_observatory_path(protocol: @protocol, run_id: entry[:run_id]), class: "text-link" %></td>
      <td><%= entry[:seed] %></td><td><%= number_with_precision(entry[:score], precision: 3) %></td><td><%= entry[:features].first["name"] %></td></tr>
    <% end %></tbody></table></div>
  </section>
<% else %>
  <section class="panel"><div class="empty-state"><h3>Nenhum relatório LUPA disponível</h3>
  <p>Execute um novo treinamento MAPA com o LUPA habilitado para gerar evidência real de importância por permutação.</p>
  <%= link_to "Abrir MAPA Laboratory →", mapa_runs_path, class: "text-link" %></div></section>
<% end %>
<div class="panel slim-panel"><strong>Limitação científica:</strong> <%= @observatory[:warning] %></div>
