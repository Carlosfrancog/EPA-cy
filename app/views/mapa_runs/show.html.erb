<% content_for :title, "MAPA ##{@run.id}" %>
<% content_for :section, "MAPA / ##{@run.id}" %>
<% if @run.waiting? %><% content_for :head do %><meta http-equiv="refresh" content="4"><% end %><% end %>
<div class="page-heading"><div><div class="eyebrow">EPA MAPA · EXECUÇÃO #<%= @run.id %></div><h1>Relatório MAPA</h1>
<p>Comparação científica experimental com dados exclusivamente sintéticos.</p></div>
<%= link_to "← Histórico MAPA", mapa_runs_path, class: "button button-outline" %></div>
<div class="stats-grid">
  <div class="stat-card"><div class="stat-label">Estado</div><div class="stat-value stat-value-text"><%= @run.status.upcase %></div></div>
  <div class="stat-card"><div class="stat-label">Seed</div><div class="stat-value"><%= @run.seed %></div></div>
  <div class="stat-card"><div class="stat-label">Protocolos</div><div class="stat-value">N1 · N2 · N3</div></div>
  <div class="stat-card"><div class="stat-label">Fonte</div><div class="stat-value stat-value-text">Sintética</div></div>
</div>
<% if @run.waiting? %>
  <div class="panel"><h3>Treinamento em andamento</h3><p>Atualização automática a cada quatro segundos.</p></div>
<% elsif @run.status == "failed" %>
  <div class="panel"><h3>Treinamento não concluído</h3><p>Código de erro: <code><%= @run.failure_code %></code></p></div>
<% elsif @report %>
  <% @report.fetch("baselines", []).each do |block| %>
    <section class="panel">
      <div class="panel-heading"><div><div class="eyebrow">PROTOCOLO N<%= block["cutoff_term"] %></div>
        <h3><%= {"early" => "MAPA Early", "trajectory" => "MAPA Trajectory", "consolidated" => "MAPA Consolidated"}.fetch(block["protocol"], block["protocol"]) %></h3></div>
        <span class="subtle-pill">F1 MACRO · 3 CLASSES</span>
      </div>
      <div class="table-wrap"><table class="runs-table"><thead><tr><th>Modelo</th><th>Acurácia</th><th>Balanceada</th><th>F1 macro</th></tr></thead><tbody>
      <% block.fetch("results", []).each do |model| %>
        <tr><td><%= model["model"].humanize %></td>
        <td><%= number_to_percentage(model["accuracy"] * 100, precision: 1) %></td>
        <td><%= number_to_percentage(model["balanced_accuracy"] * 100, precision: 1) %></td>
        <td><%= number_with_precision(model["f1_macro"], precision: 3) %></td></tr>
      <% end %></tbody></table></div>
      <p class="muted">Observações: <%= block["train_observations"] %> treino / <%= block["test_observations"] %> teste. Suporte por classe no teste: <%= block["test_class_counts"].map { |key, val| "#{key}: #{val}" }.join(" · ") %>.</p>
      <% block.fetch("results", []).each do |model| %>
        <details><summary><strong><%= model["model"].humanize %></strong> — matriz de confusão 3×3 e recall por classe</summary>
          <div class="table-wrap"><table class="runs-table"><thead><tr><th>Real / Previsto</th><% block["classes"].each do |label| %><th><%= label %></th><% end %></tr></thead>
          <tbody><% model["confusion_matrix"].each_with_index do |row, index| %><tr><th><%= block["classes"][index] %></th><% row.each do |value| %><td><%= value %></td><% end %></tr><% end %></tbody></table></div>
          <p>Recall: <%= model["recall_by_class"].map { |key, val| "#{key} #{number_to_percentage(val * 100, precision: 1)}" }.join(" · ") %></p>
        </details>
      <% end %>
    </section>
  <% end %>
  <% if (ext = @run.extended_report) %>
    <section class="panel"><div class="eyebrow">MAPA · MODELOS ESTENDIDOS</div><h3>MLP / XGBoost opcional</h3>
      <% ext.fetch("protocols", []).each do |p| %>
        <h4>Protocolo N<%= p["cutoff_term"] %></h4>
        <div class="table-wrap"><table class="runs-table"><thead><tr><th>Modelo</th><th>Status</th><th>F1 macro</th><th>Acurácia balanceada</th></tr></thead><tbody>
        <% p.fetch("results", []).each do |m| %>
          <tr><td><%= m["model"].humanize %></td><td><%= m["status"] %></td>
            <td><%= m["status"] == "evaluated" ? number_with_precision(m["f1_macro"], precision: 3) : "—" %></td>
            <td><%= m["status"] == "evaluated" ? number_with_precision(m["balanced_accuracy"], precision: 3) : "—" %></td></tr>
        <% end %></tbody></table></div>
      <% end %>
      <p class="muted">Pesquisa sintética; não há validação externa. SHA-256: <code><%= @run.extended_sha256 %></code></p>
    </section>
  <% end %>
  <% if (local = @run.lupa_local_report) %>
    <section class="panel"><div class="eyebrow">LUPA · DIAGNÓSTICO DE ERROS</div><h3>Casos sintéticos classificados incorretamente</h3>
      <p class="muted">Amostra de até 12 erros por protocolo, sem IDs de estudantes e sem registros individuais de notas. Substituição pela mediana é teste de sensibilidade, não intervenção.</p>
      <% local.fetch("protocols", []).each do |block| %>
        <h4>N<%= block["cutoff_term"] %> · <%= block["error_observations"] %> erros em <%= block["test_observations"] %> observações</h4>
        <div class="table-wrap"><table class="runs-table"><thead><tr><th>Caso</th><th>Real</th><th>Previsto</th><th>Confiança</th><th>Variável de maior sensibilidade local</th></tr></thead><tbody>
        <% block.fetch("cases", []).each do |item| %>
          <tr><td>#<%= item["case_number"] %></td><td><%= item["actual"] %></td><td><%= item["predicted"] %></td>
          <td><%= number_to_percentage(item["predicted_probability"] * 100, precision: 1) %></td>
          <td><%= item.fetch("top_sensitivities", []).first&.fetch("feature", "—") %></td></tr>
        <% end %></tbody></table></div>
      <% end %>
      <p class="muted">SHA-256 do diagnóstico: <code><%= @run.lupa_local_sha256 %></code></p>
    </section>
  <% end %>
  <% if (lupa = @run.lupa_report) %>
    <section class="panel"><div class="eyebrow">LUPA · EXPLICABILIDADE</div><h3>Sensibilidade preditiva por variável</h3>
      <p class="muted">Importância por permutação no conjunto de teste do Random Forest. Queda do F1 macro ao embaralhar cada variável; não demonstra causalidade.</p>
      <% lupa.fetch("explanations", []).each do |explanation| %>
        <h4>Protocolo N<%= explanation["cutoff_term"] %> · Random Forest</h4>
        <p class="muted">F1 de referência: <%= number_with_precision(explanation["baseline_f1_macro"], precision: 3) %> · Teste: <%= explanation["test_observations"] %> observações</p>
        <div class="table-wrap"><table class="runs-table"><thead><tr><th>Variável</th><th>Queda média F1</th><th>Desvio</th></tr></thead><tbody>
        <% explanation.fetch("features", []).each do |feature| %>
          <tr><td><code><%= feature["name"] %></code></td><td><%= number_with_precision(feature["mean_f1_drop"], precision: 4) %></td>
          <td><%= number_with_precision(feature["std_f1_drop"], precision: 4) %></td></tr>
        <% end %></tbody></table></div>
      <% end %>
      <p class="muted">SHA-256 LUPA: <code><%= @run.lupa_sha256 %></code></p>
    </section>
  <% else %>
    <section class="panel"><h3>LUPA</h3><p class="muted">Explicabilidade não disponível nesta execução histórica.</p></section>
  <% end %>
  <% if (research = @run.research_report) %>
    <section class="panel"><div class="eyebrow">MAPA RESEARCH PROTOCOL v0.2</div><h3>Validação cruzada agrupada</h3>
      <p class="muted">Distribuição de folds, não intervalo de confiança populacional.</p>
      <% research.fetch("protocols", []).each do |protocol| %>
        <h4>Protocolo N<%= protocol["cutoff_term"] %></h4>
        <p class="muted">Validação temporal: <strong><%= protocol.dig("temporal_holdout", "status") %></strong>
        <% if protocol.dig("temporal_holdout", "reason") %> · <%= protocol.dig("temporal_holdout", "reason") %><% end %></p>
        <% if protocol.dig("temporal_holdout", "status") == "evaluated" %>
          <div class="table-wrap"><table class="runs-table"><thead><tr><th>Modelo (coorte posterior)</th><th>F1 macro</th><th>Intervalo bootstrap 95%</th></tr></thead><tbody>
            <% protocol.dig("temporal_holdout", "models").each do |tm| %>
              <% uncertainty = tm["f1_macro_cluster_interval"] || {} %>
              <tr><td><%= tm["model"].humanize %></td><td><%= number_with_precision(tm["f1_macro"], precision: 3) %></td>
              <td><% if uncertainty["status"] == "estimated" %><%= number_with_precision(uncertainty["lower"], precision: 3) %>–<%= number_with_precision(uncertainty["upper"], precision: 3) %><% else %>Indisponível<% end %></td></tr>
            <% end %>
          </tbody></table></div>
          <p class="muted">Intervalo percentílico 95%, reamostragem por aluno da coorte de teste, condicional ao modelo já treinado. Não mede incerteza de treinamento nem generalização real.</p>
        <% end %>
        <div class="table-wrap"><table class="runs-table"><thead><tr><th>Modelo</th><th>F1 médio</th><th>Desvio</th><th>Faixa de F1</th><th>Folds sem classe</th></tr></thead><tbody>
        <% protocol.fetch("summaries", []).each do |summary| %>
          <% stats = summary["f1_macro_fold_distribution"] %>
          <tr><td><%= summary["model"].humanize %></td><td><%= number_with_precision(stats["mean"], precision: 3) %></td>
            <td><%= number_with_precision(stats["std"], precision: 3) %></td>
            <td><%= number_with_precision(stats["min"], precision: 3) %>–<%= number_with_precision(stats["max"], precision: 3) %></td>
            <td><%= summary["missing_class_folds"] %></td></tr>
        <% end %></tbody></table></div>
      <% end %>
      <p class="muted">SHA-256 do relatório de pesquisa: <code><%= @run.research_sha256 %></code></p>
    </section>
  <% else %>
    <section class="panel"><h3>Validação científica adicional</h3><p class="muted">Não disponível nesta execução histórica.</p></section>
  <% end %>
  <section class="panel"><div class="eyebrow">MLFLOW · RASTREAMENTO OPCIONAL</div><h3>Identificadores dos modelos</h3>
    <% if @run.mlflow_links.any? %>
      <div class="table-wrap"><table class="runs-table"><thead><tr><th>Protocolo</th><th>Algoritmo</th><th>MLflow Run ID</th></tr></thead><tbody>
      <% @run.mlflow_links.each do |entry| %>
        <tr><td><%= entry["protocol"] %></td><td><%= entry["model"] %></td><td><code><%= entry["run_id"] %></code></td></tr>
      <% end %></tbody></table></div>
    <% else %>
      <p class="muted">Rastreamento MLflow não configurado para esta execução. O relatório local continua disponível.</p>
    <% end %>
  </section>
  <section class="panel"><h3>Rastreabilidade</h3><p>Manifesto SHA-256: <code><%= @run.dataset_manifest_sha256 %></code></p>
  <p>Relatório SHA-256: <code><%= @run.report_sha256 %></code></p></section>
<% else %><section class="panel"><p>Relatório indisponível.</p></section><% end %>
<div class="panel slim-panel"><strong>Limite da pesquisa:</strong> os dados são simulados. Os resultados não comprovam eficácia preditiva em populações escolares reais.</div>
