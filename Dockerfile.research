FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/epa
COPY pyproject.toml ./
COPY epa/ ./epa/
RUN python -m pip install --upgrade pip \
    && python -m pip install '.[dev,research,streaming]'

WORKDIR /workspace
CMD ["python", "--version"]
